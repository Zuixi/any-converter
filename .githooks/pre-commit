#!/bin/bash
# Shared pre-commit hook: format check, clippy, tests, webview guards.
set -euo pipefail

echo "[pre-commit] Running format check..."
cargo fmt --all -- --check

echo "[pre-commit] Running clippy..."
cargo clippy --workspace --lib --all-features -- -D warnings

echo "[pre-commit] Running tests..."
cargo test --workspace

echo "[pre-commit] Checking desktop webview guards..."
./scripts/guard-no-loopback-fetch.sh

echo "[pre-commit] All checks passed."
