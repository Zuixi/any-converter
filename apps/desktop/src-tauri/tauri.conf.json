{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "any-converter",
  "version": "0.1.3",
  "identifier": "dev.any-converter.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm install && pnpm build",
    "devUrl": "http://localhost:8420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "any-converter",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/node"]
  }
}
